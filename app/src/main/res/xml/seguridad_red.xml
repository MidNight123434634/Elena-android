<?xml version="1.0" encoding="utf-8"?>
<!-- La app confía en los sitios normales y, además, en el certificado de tu PC (la autoridad de la ferretería).
     Así se conecta a Elena por NetBird con conexión cifrada, sin instalar nada en el teléfono. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/jarvis_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
